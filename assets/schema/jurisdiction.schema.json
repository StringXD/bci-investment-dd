{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/StringXD/bci-investment-dd/assets/schema/jurisdiction.schema.json",
  "title": "Jurisdiction profile (jurisdiction-profile/1)",
  "description": "编辑器提示与 CI 预检用的形状声明。**权威是 scripts/lib/jurisdiction.mjs**: 语义(例如 charter_defined 与 thresholds 互斥、pending 时允许 edges 为空、退出通道必须含 unknown)只在那里实现一遍, 这里不重复表达。顶层键面由 tests/jurisdictions.mjs 断言锁在校验器导出的 TOP_KEYS / REQUIRED_TOP 上, 所以本文件不会悄悄多一个或少一个键。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "as_of",
    "currency",
    "admission_only",
    "control_lines",
    "rev_mult",
    "sensitivity_rates",
    "exit_channels"
  ],
  "properties": {
    "schema": { "const": "jurisdiction-profile/1" },
    "id": {
      "enum": ["cn", "us", "eu"],
      "description": "必须与文件名一致(cn.json 的 id 只能是 cn)"
    },
    "as_of": { "$ref": "#/definitions/date" },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "本辖区默认计价币种。输入未声明币种时用它, 金额前缀与量级词正交"
    },
    "admission_only": {
      "type": "boolean",
      "description": "true 表示本档只做准入对照、不产出评分; 拿它评分时脚本必须 exit 2(P-06)"
    },
    "_doc": {
      "type": "string",
      "description": "编制说明。允许存在, 但不参与任何判定"
    },
    "control_lines": { "$ref": "#/definitions/control_lines" },
    "rev_mult": { "$ref": "#/definitions/rev_mult" },
    "sensitivity_rates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
      "description": "折现率三档(与报告敏感性的三列对应), 严格递增由校验器查"
    },
    "exit_channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/exit_channel" },
      "description": "必须含 key=unknown 的兜底项(is_channel=false), 否则「未填退出路径」会被读成「有多种选择」"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "item", "why", "how"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "item": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "how": { "type": "string", "minLength": 1 }
        }
      },
      "description": "本档自陈的缺口。写在这里而不是只写在注释里, 才能被报告引用"
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 日期。不带时区: 辖区档描述的是「截至哪一天」, 不是某一瞬间"
    },
    "status": {
      "enum": ["verified", "methodology", "pending"],
      "description": "verified=有一手来源且逐条核到原文; methodology=方法学假设/规则名可查但未核条款; pending=尚未核实(不出数字, 出拒答行并计入 gaps)"
    },
    "provenance": {
      "type": "object",
      "required": ["source_ref", "as_of", "status"],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1 },
        "as_of": { "$ref": "#/definitions/date" },
        "status": { "$ref": "#/definitions/status" }
      }
    },
    "control_lines": {
      "allOf": [{ "$ref": "#/definitions/provenance" }],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "charter_defined": {
          "const": true,
          "description": "本辖区没有统一的法定持股阈值, 控制线由公司章程与投资者协议约定 —— 此时不给任何默认数字"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0, "maximum": 100 },
          "description": "百分数阈值。每个阈值都必须能在词表里按 own.line.<阈值> 取到简称, 否则会印出没有名字的控制线"
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "as_of": { "$ref": "#/definitions/date" },
        "status": { "$ref": "#/definitions/status" }
      },
      "description": "charter_defined 与 thresholds 互斥(二者并存时读者无法判断以哪套为准), 该互斥由校验器 P-02 判定, 此处不表达"
    },
    "rev_mult": {
      "allOf": [{ "$ref": "#/definitions/provenance" }],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edges": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "description": "收入档边界, 严格递增。status=pending 时允许空数组: 不给数字与给错数字是两件事"
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "as_of": { "$ref": "#/definitions/date" },
        "status": { "$ref": "#/definitions/status" }
      }
    },
    "exit_channel": {
      "allOf": [{ "$ref": "#/definitions/provenance" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "is_channel", "applicable", "source_ref", "as_of", "status"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "文案 key 由词表按此键提供(exit.<key>.label), 档里不写标签。不在此处枚举可用键: 通道清单随辖区事实增减, 枚举会变成第二真源, 词表缺键由 tests/i18n.mjs 兜住"
        },
        "is_channel": {
          "type": "boolean",
          "description": "unknown 之类不是真通道, 必须为 false"
        },
        "applicable": {
          "type": "boolean",
          "description": "本辖区是否适用。false 时报告印「该路径在本辖区不适用」, 而不是静默删掉这一行"
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "as_of": { "$ref": "#/definitions/date" },
        "status": { "$ref": "#/definitions/status" }
      }
    }
  }
}
