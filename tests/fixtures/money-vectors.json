{
  "schema": "money-vectors/1",
  "note": "金额格式化的逐字向量表。期望值是**按规则写下来的**, 不是从实现快照出来的: 快照会把 bug 一起固化。三条规则: 量级词跟随 locale(亿/万 vs B/M/K)、币种符号跟随币种(CNY 不加前缀 vs USD 加 $)、两者正交(中文+美元 = USD 12.5 亿)。",
  "money": [
    { "x": 0, "c": "CNY", "l": "zh-CN", "want": "0", "why": "零不加量级词" },
    { "x": 1, "c": "CNY", "l": "zh-CN", "want": "1" },
    { "x": 1234, "c": "CNY", "l": "zh-CN", "want": "1234", "why": "中文不用千分位, 未到万不加量级词" },
    { "x": 9999, "c": "CNY", "l": "zh-CN", "want": "9999", "why": "万的下界是严格 1e4" },
    { "x": 10000, "c": "CNY", "l": "zh-CN", "want": "1 万" },
    { "x": 12000, "c": "CNY", "l": "zh-CN", "want": "1.2 万" },
    { "x": 12345, "c": "CNY", "l": "zh-CN", "want": "1.2 万", "why": "万档一位小数" },
    { "x": 12000000, "c": "CNY", "l": "zh-CN", "want": "1200 万", "why": "**不进位**成 0.12 亿: 1e4 进制里 1200 万才是人话" },
    { "x": 41000000, "c": "CNY", "l": "zh-CN", "want": "4100 万" },
    { "x": 99999999, "c": "CNY", "l": "zh-CN", "want": "1 亿", "why": "按万档四舍五入得 10000 万, 溢出即进位" },
    { "x": 100000000, "c": "CNY", "l": "zh-CN", "want": "1 亿" },
    { "x": 999999999, "c": "CNY", "l": "zh-CN", "want": "10 亿" },
    { "x": 1250000000, "c": "CNY", "l": "zh-CN", "want": "12.5 亿" },
    { "x": -12000000, "c": "CNY", "l": "zh-CN", "want": "-1200 万", "why": "负号在数字前" },
    { "x": -1250000000, "c": "CNY", "l": "zh-CN", "want": "-12.5 亿" },

    { "x": 12000000, "c": "USD", "l": "zh-CN", "want": "USD 1200 万", "why": "正交: 中文量级词 + 美元前缀" },
    { "x": -12000000, "c": "USD", "l": "zh-CN", "want": "USD -1200 万", "why": "负号在数字前、币种前置于整个数值" },
    { "x": 1250000000, "c": "USD", "l": "zh-CN", "want": "USD 12.5 亿" },
    { "x": 0, "c": "USD", "l": "zh-CN", "want": "USD 0" },
    { "x": 12000000, "c": "EUR", "l": "zh-CN", "want": "EUR 1200 万" },
    { "x": 12000000, "c": "ABC", "l": "zh-CN", "want": "ABC 1200 万", "why": "未知币种原样大写输出, 不猜符号" },
    { "x": 12000000, "c": "", "l": "zh-CN", "want": "1200 万", "why": "空币种 = 不标币种" },

    { "x": 0, "c": "USD", "l": "en-US", "want": "$0" },
    { "x": 999, "c": "USD", "l": "en-US", "want": "$999", "why": "K 的下界是严格 1e3" },
    { "x": 1000, "c": "USD", "l": "en-US", "want": "$1K" },
    { "x": 1234, "c": "USD", "l": "en-US", "want": "$1.2K", "why": "K 档一位小数: 0 位会把 1,234 印成 $1K" },
    { "x": 1500, "c": "USD", "l": "en-US", "want": "$1.5K" },
    { "x": 999950, "c": "USD", "l": "en-US", "want": "$1M", "why": "M 档四舍五入得 1.0M, 不越档" },
    { "x": 1000000, "c": "USD", "l": "en-US", "want": "$1M" },
    { "x": 1250000, "c": "USD", "l": "en-US", "want": "$1.3M" },
    { "x": 999950000, "c": "USD", "l": "en-US", "want": "$1B", "why": "跨档进位: 999.95M 印成 1000M 就是错的" },
    { "x": 1250000000, "c": "USD", "l": "en-US", "want": "$1.25B" },
    { "x": -12000000, "c": "USD", "l": "en-US", "want": "-$12M", "why": "负号在币种符号前" },
    { "x": -1250000000, "c": "USD", "l": "en-US", "want": "-$1.25B" },
    { "x": 1200000000, "c": "CNY", "l": "en-US", "want": "CNY 1.2B", "why": "正交: 英文量级词 + 人民币代码" },
    { "x": -12000000, "c": "CNY", "l": "en-US", "want": "-CNY 12M" },
    { "x": 12000000, "c": "EUR", "l": "en-US", "want": "€12M" },
    { "x": 12000000, "c": "GBP", "l": "en-US", "want": "£12M" },
    { "x": 12000000, "c": "JPY", "l": "en-US", "want": "¥12M" },
    { "x": 12000000, "c": "ABC", "l": "en-US", "want": "ABC 12M", "why": "未知币种不加符号" },
    { "x": 12000000, "c": "", "l": "en-US", "want": "12M" },

    { "x": null, "c": "CNY", "l": "zh-CN", "want": "-", "why": "缺数不写 0" },
    { "x": null, "c": "USD", "l": "en-US", "want": "-" }
  ],
  "pct": [
    { "x": 0.125, "want": "12.5%" },
    { "x": 0.1234, "want": "12.3%" },
    { "x": 1, "want": "100%" },
    { "x": 0, "want": "0%" },
    { "x": null, "want": "-" }
  ],
  "count": [
    { "x": 1234, "l": "zh-CN", "want": "1234", "why": "中文报告原本不用千分位" },
    { "x": 1234, "l": "en-US", "want": "1,234" },
    { "x": 1234567, "l": "en-US", "want": "1,234,567" },
    { "x": -1234, "l": "en-US", "want": "-1,234" },
    { "x": 999, "l": "en-US", "want": "999" }
  ]
}
